  "item": [
    {
      "name": "AT01 - Cadastro de usuário",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 201 - Criado com sucesso\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Resposta contém id e email\", function () {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body).to.have.property(\"id\");\r",
              "    pm.expect(body.email).to.eql(\"giovanna.teste3@email.com\");\r",
              "    pm.expect(body.pontos).to.eql(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nome\": \"Giovanna Teste\",\r\n  \"email\": \"giovanna.teste3@email.com\",\r\n  \"senha\": \"Teste@123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/register",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "AT02 - Login com credenciais válidas",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200 - Login com sucesso\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Token JWT retornado\", function () {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body).to.have.property(\"token\");\r",
              "    pm.expect(body.token).to.be.a(\"string\");\r",
              "    pm.environment.set(\"token\", body.token);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"giovanna.teste@email.com\",\r\n  \"senha\": \"Teste@123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "AT03 - Iniciar desafio",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200 - Desafio iniciado\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Status do desafio é EM_ANDAMENTO\", function () {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.status).to.eql(\"EM_ANDAMENTO\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
