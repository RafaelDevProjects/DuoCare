    {
      "name": "AT04 - Atualizar progresso do desafio",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200 - Progresso atualizado\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Desafio concluído com 100%\", function () {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.status).to.eql(\"CONCLUIDO\");\r",
              "    pm.expect(body.percentual).to.eql(100.0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
